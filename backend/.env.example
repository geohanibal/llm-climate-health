# Copy this file to .env and fill in your own key. .env is gitignored.

# Google Gemini API key, used to (a) explain a finished pipeline run in
# plain language, and (b) turn a free-text request into a form prefill.
# Get one at https://aistudio.google.com/apikey — the free tier is enough
# for this project. If left empty, both features degrade gracefully:
# explanations fall back to a static generic description, and
# POST /api/parse-request returns a 503 telling the user to fill the form
# manually.
GEMINI_API_KEY=

# Optional: override the default Gemini model.
GEMINI_MODEL=gemini-flash-lite-latest

# Thai Meteorological Department API credentials (Thailand-only climate
# source). Register for free at https://data.tmd.go.th — if left empty,
# the "tmd" climate source is simply unavailable (POST /api/integrate with
# climate_source=tmd fails with a clear error; the other two climate
# sources are unaffected).
#
# For quick testing without registering, TMD's own docs publish a demo
# pair that works against the real API: TMD_API_UID=demo /
# TMD_API_UKEY=demokey. Verified 2026-08-23 — that tier only ever returns
# the current (in-progress) year, not historical data, so it's useful for
# exercising the pipeline but not for a real historical query. See
# app/services/tmd.py's module docstring for what else was discovered
# from a real response (XML, not JSON; swapped lat/lon fields).
TMD_API_UID=
TMD_API_UKEY=
